# Copy this file to backend/.env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here
# true = skip live Gemini calls and serve placeholder questions (fast, for dev)
MOCK_LLM=true
# true = serve the pre-generated 250-question bank in data_generation/question_bank.json
USE_QUESTION_BANK=true

# --- Deployment (all optional for local development) -------------------------------------------
# PostgreSQL connection string. Unset = a local SQLite file (backend/tutor_state.db).
# Set it (e.g. a Neon "pooled" URL ending in ?sslmode=require) to store student data in PostgreSQL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Browser origins allowed to call the API, comma-separated. Unset = any origin in development,
# NONE when NEURO_ENV=production.
# CORS_ORIGINS=https://your-site.vercel.app
# NEURO_ENV=production
# LOG_LEVEL=INFO
# DB_POOL_MAX=6
