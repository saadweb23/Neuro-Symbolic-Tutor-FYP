# Copy to .env.local for local overrides. In production set this in the Vercel project settings
# (Settings > Environment Variables), NOT in a committed file. It is baked into the build, so it
# must be the public URL of the API; never put secrets in a VITE_* variable (they ship to browsers).
#
# Local development needs nothing: the app talks to http://<page hostname>:8000 by default.
VITE_API_BASE=https://neurotutor-api.onrender.com
